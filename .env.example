# PhishLens configuration. Copy to .env and fill in what you need, then pass
# it to uv:  uv run --env-file .env uvicorn --factory phishlens.api:create_app
# .env is git-ignored; never commit real keys.
#
# Every key below is optional. A check that needs a missing key is skipped,
# and the report says so.

# --- Threat-intelligence services -------------------------------------------
# Privacy: these services receive the URL being checked. Using them sends
# user data to a third party, so the checks that call them only send the URL,
# never email content.

# VirusTotal: URL reputation from many scanners.
PHISHLENS_VIRUSTOTAL_API_KEY=

# PhishTank: community list of confirmed phishing URLs.
PHISHLENS_PHISHTANK_API_KEY=

# URLScan: scans a page and reports what it loads. Scans can be public, so
# the check must submit them with private visibility.
PHISHLENS_URLSCAN_API_KEY=

# --- Engine -----------------------------------------------------------------

# Comma-separated check names to turn off, for example "email.dkim,url.shortener".
# An unknown name stops the engine at startup.
PHISHLENS_DISABLED_CHECKS=

# Where the popular-domain list from scripts/fetch_tranco.py is read from.
# Defaults to shared/data/tranco-top10k.txt; set it empty to use no list.
# PHISHLENS_POPULAR_DOMAINS=

# --- Email authentication ---------------------------------------------------
# Both are empty by default: for a pasted email we can't know which provider
# received it, so only the topmost external Received hop is used and no
# Authentication-Results header is believed.

# Comma-separated hosts of your own mail system, for example "google.com".
# When set, SPF uses the hop where mail entered these hosts from outside.
PHISHLENS_TRUSTED_RECEIVERS=

# Comma-separated authserv-ids whose Authentication-Results headers can be
# believed, for example "mx.google.com". Others are reported and ignored.
PHISHLENS_TRUSTED_AUTHSERV_IDS=
